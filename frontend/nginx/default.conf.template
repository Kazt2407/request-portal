server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # File names carry a content hash, so they never change: cache them for a year.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Per-environment settings the app reads at startup.
    location = /config.json {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store";
        default_type application/json;
        return 200 '{"keycloakUrl": "${KEYCLOAK_URL}", "realm": "${KEYCLOAK_REALM}", "clientId": "${KEYCLOAK_CLIENT_ID}"}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Any other path is a page of the single-page app.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
